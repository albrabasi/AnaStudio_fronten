/* Splash Screen */
#splash-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #0f172a;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  transition: opacity 0.5s ease-out;
}

.splash-logo {
  font-size: 2.5rem;
  font-weight: 700;
  color: #fbbf24;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.8; }
  100% { transform: scale(1); opacity: 1; }
}

.fade-out {
  opacity: 0;
  pointer-events: none;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.container {
  width: 100%;
  max-width: 500px;
}

.card {
  background: #1e293b;
  padding: 40px;
  border-radius: 20px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
  border: 1px solid #334155;
}

h1 {
  margin-top: 0;
  margin-bottom: 8px;
  text-align: center;
  color: #f8fafc;
  font-weight: 700;
  letter-spacing: -0.025em;
}

.subtitle {
  margin-top: 0;
  margin-bottom: 32px;
  text-align: center;
  color: #94a3b8;
  font-size: 0.95rem;
}

label {
  display: block;
  margin-top: 20px;
  margin-bottom: 8px;
  font-weight: 500;
  font-size: 0.9rem;
  color: #cbd5e1;
}

textarea,
input,
select {
  width: 100%;
  padding: 14px;
  border: 1px solid #475569;
  border-radius: 10px;
  background: #0f172a;
  color: #f8fafc;
  font-family: inherit;
  font-size: 16px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

textarea:focus,
input:focus,
select:focus {
  outline: none;
  border-color: #fbbf24;
  box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.2);
}

textarea {
  min-height: 150px;
  resize: vertical;
}

.character-count {
  margin-top: 8px;
  text-align: right;
  font-size: 0.8rem;
  color: #64748b;
}

.button-area {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 32px;
}

button,
.download-button {
  padding: 14px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #fbbf24, #d97706);
  color: #1e293b;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  transition: transform 0.1s, opacity 0.2s;
}

button:hover,
.download-button:hover {
  opacity: 0.9;
}

button:active,
.download-button:active {
  transform: scale(0.98);
}

button:disabled {
  background: #475569;
  color: #94a3b8;
  cursor: not-allowed;
}

.download-button {
  display: none;
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
}

#status {
  margin-top: 24px;
  color: #94a3b8;
  font-size: 0.9rem;
  text-align: center;
  line-height: 1.5;
}

audio {
  display: none;
  width: 100%;
  margin-top: 24px;
  filter: invert(0.9);
}

.info {
  margin-top: 32px;
  padding: 20px;
  border-radius: 12px;
  background: #334155;
  color: #cbd5e1;
  font-size: 0.85rem;
  line-height: 1.6;
}
